# Odoo Configuration
DB_NAME=your-odoo-database
UID=your-user-id
API_KEY=your-odoo-api-key

# WordPress Configuration
WP_USERNAME=your-wp-username
WP_PASSWORD=your-wp-app-password

# Auth Configuration
AUTH_TOKEN=your-bearer-token

# Mini-apps — AI (window.platform.ai.ask(), zie src/modules/mini-apps/lib/ai.js)
# ANTHROPIC_API_KEY: primaire provider (AI_PROVIDER=anthropic in wrangler.jsonc),
# draait op het team's eigen Claude-abonnement -- zie lib/ai-providers/anthropic.js.
# In productie via `wrangler secret put ANTHROPIC_API_KEY`, nooit hier invullen.
ANTHROPIC_API_KEY=your-anthropic-api-key

# GEMINI_API_KEY: optionele fallback-provider (gratis laag van Google's Gemini
# API, LOS van een Google Workspace-abonnement -- zie lib/ai-providers/gemini.js).
# In productie via `wrangler secret put GEMINI_API_KEY`, nooit hier invullen.
GEMINI_API_KEY=your-gemini-api-key
