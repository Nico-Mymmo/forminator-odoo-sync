    "blocks": [
      {
        "id": "x-title",
        "type": "heading",
        "level": 2,
        "text": "Fijn dat je erbij was!"
      },
      {
        "id": "x-hallo",
        "type": "text",
        "html": "<p style=\"margin:0 0 12px 0;\">Beste {{registration.first_name}},</p>"
      },
      {
        "id": "x-dank",
        "type": "text",
        "html": "<p style=\"margin:0 0 12px 0;\">Bedankt dat je deelnam aan <strong>{{event.title}}</strong>.</p>"
      },
      {
        "id": "x-opname-intro",
        "type": "text",
        "html": "<p style=\"margin:0;\">Hieronder kan je de opname opnieuw bekijken.</p>"
      },
      {
        "id": "x-card-video",
