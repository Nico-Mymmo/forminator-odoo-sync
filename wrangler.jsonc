/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forminator-sync",
	"main": "src/index.js",
	"compatibility_date": "2025-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "MAPPINGS_KV",
			"id": "04e4118b842b48a58f5777e008931026",
			"remote": true
		}
	],
	// R2_ASSETS = R2 bucket binding voor de asset_manager module
	// ASSETS (hieronder) = static files binding voor de /public/ map
	// Dit zijn twee verschillende bindings met twee verschillende namen — geen conflict
	"r2_buckets": [
		{
			"binding": "R2_ASSETS",
			"bucket_name": "openvme-assets",
			"remote": true
			// remote: true = echte bucket in zowel wrangler dev als wrangler deploy
			// Geen preview_bucket_name — geen aparte dev-bucket
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"triggers": {
		// "*/15 * * * *"  -> bestaande 15-min jobs (cx_powerboard, cx_automations, mini-apps geplande taken)
		// "*/5 * * * *"   -> NIEUW, apart: mini-apps criteria-taken (condition-scheduler.js), bewust sneller
		"crons": ["*/15 * * * *", "*/5 * * * *"]
	},
	"vars": {
		// Public-facing base URL — used when generating Claude project instructions
		// from a local dev environment so that the instructions always point to production.
		"APP_BASE_URL": "https://forminator-sync.openvme-odoo.workers.dev",
		// Mini-apps AI (window.platform.ai.ask(), zie src/modules/mini-apps/lib/ai.js) —
		// ANTHROPIC_API_KEY zelf is een secret (wrangler secret put), NIET hier.
		// Gemini blijft geregistreerd als fallback (AI_PROVIDER: "gemini" + GEMINI_API_KEY secret).
		//
		// ANTHROPIC_MODEL is de STANDAARD voor aanroepen die zelf geen model
		// opgeven. Let op de voorrangsorde in ai-providers/anthropic.js:
		// model (van de mini-app, begrensd door MODEL_ALLOWLIST) > ANTHROPIC_MODEL
		// > DEFAULT_MODEL. Deze waarde stond op claude-sonnet-4-6 en overschreef
		// daarmee de nieuwe DEFAULT_MODEL; gelijkgezet op claude-sonnet-5
		// (goedkoper op input, 1M context, 128k output). Zet hier UITSLUITEND een
		// model dat ook in MODEL_ALLOWLIST staat, anders kan een mini-app het
		// niet expliciet kiezen terwijl het wel de stille standaard is.
		"AI_PROVIDER": "anthropic",
		"ANTHROPIC_MODEL": "claude-sonnet-5",
		"GEMINI_MODEL": "gemini-flash-lite-latest",
		"EVENTS_PUBLIC_ORIGINS": "https://openvme.be,https://syndicoach.be",
		// Koppelingen -- publieke formulier-API (mymmo-forms-plugin). Alleen
		// nodig voor CORS; de plugin praat server-naar-server en heeft dit niet
		// nodig. De SLEUTEL is een secret: FORMS_PUBLIC_SITE_KEYS, in de vorm
		// "openvme:<sleutel>,syndicoach:<sleutel>". Zonder die secret is de
		// publieke formulier-API dicht, niet open.
		"FORMS_PUBLIC_ORIGINS": "https://openvme.be,https://syndicoach.be",
		// Event Operations v2 -- auto-done cron (draait mee in de 15-min-cron-tak,
		// zie src/modules/event-operations-v2/lib/cron.js). Standaard AAN; zet op
		// "0" om 'm zonder deploy uit te zetten (Cloudflare-dashboard volstaat).
		"EVENTS_V2_AUTO_DONE_CRON": "1",
		// Event Operations v2 -- communicatie-studio. Bepaalt voor WELKE
		// event-types de OM de mails (bevestiging/reminder/recap) overneemt van
		// de Odoo-automations 53/58/62/63. Kommagescheiden event-type-id's, of
		// "*" voor alles.
		//
		// LEEG = de OM zet geen enkele mail klaar en alles blijft bij het oude.
		// Dat is bewust de veilige stand: een deploy op zich kan nooit een mail
		// veroorzaken. Zolang de oude rules aan staan is dit ook geen dubbele
		// verzending -- hun filter is exact x_studio_confirmation_email_sent =
		// False resp. x_studio_reminder_email_sent = False, en de OM zet die vlag.
		//
		// Event-type-id's (geverifieerd 2026-09-06): 1 Webinar, 2 Infosessie,
		// 3 Q&A, 4 Live Event, 5 Groepsopleiding.
		//
		// "*" pikt ook LATER TOEGEVOEGDE event-types automatisch op: er is geen
		// deploy of aanpassing nodig als er een type bijkomt. Dat is de reden om
		// hier "*" te zetten in plaats van een lijst id's.
		//
		// LET OP zodra de Odoo-automations uit staan: een nieuw event-type
		// zonder opgemaakte mailblokken stuurt dan NIETS. queueMails() slaat het
		// over en zet de _sent-vlag terug op false, dus je ziet in het
		// inschrijvingenoverzicht dat de mail ontbreekt -- maar er is geen
		// vangnet meer dat hem alsnog stuurt. De OM waarschuwt daarom op twee
		// plekken: een gele balk op het eventpaneel, en een rode badge in de
		// studio. Vul bij een nieuw type dus eerst de mails in voor je events van
		// dat type publiceert.
		"EVENTS_V2_MAIL_OWNER": "*",
		// Herstelronde voor al klaargezette reminders waarvan het event nadien
		// verplaatst of geannuleerd werd (15-min-tak). Standaard AAN; "0" zet 'm
		// uit zonder deploy. GEEN dagelijkse herberekening -- de scheduled_date
		// wordt bij het inschrijven gezet.
		"EVENTS_V2_MAIL_REPAIR_CRON": "1",
		// Event Operations v2 -- over WELKE ir.mail_server de eventmails
		// vertrekken. 6 = "Postmark - Webinar communication"
		// (smtp.postmarkapp.com, SMTP-token PM-T-events-communica-...), een
		// TRANSACTIONELE Postmark-stream.
		//
		// WAAROM DIT EXPLICIET MOET. Zonder mail_server_id kiest Odoo de server
		// met de laagste sequence, en dat is nummer 4 ("Postmark",
		// smtp-broadcasts.postmarkapp.com, PM-B-newsletter-...): de
		// BROADCAST-stream van de nieuwsbrief. Alle eventmails vertrokken
		// daarover. Twee gevolgen: de webhook van die stream kreeg elke
		// nieuwsbriefgebeurtenis mee (ruis), en -- erger -- een broadcaststream
		// onderdrukt adressen die zich uitschreven, dus wie de nieuwsbrief
		// opzegde kreeg zijn eventbevestiging stil niet.
		//
		// De stream zit IN het SMTP-token; er hoort dus GEEN
		// X-PM-Message-Stream-header bij (zie postmark-tracking.js). Zelfde
		// afspraak en zelfde aanpak als de koppelingen-module, die haar
		// mailserver ook expliciet meegeeft (target.mail_server_id in
		// forminator-sync-v2/mail-step.js, ir.mail_server 5).
		//
		// LEEG = Odoo kiest zelf, dus het oude gedrag. Dat is bewust de veilige
		// stand: een deploy op zich verandert dan niets aan de verzendweg.
		"EVENTS_V2_MAIL_SERVER_ID": "6",
		"BASE_ASSET_URL": "https://link.openvme.be",
		"EVENTS_SHARED_CANONICAL_ORIGIN": "https://openvme.be"
	}
}