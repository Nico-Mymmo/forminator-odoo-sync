# Local development environment variables
# Copy this file to .dev.vars and fill in your values

# Odoo Configuration
DB_NAME=mymmo-main-11883993
UID=2
API_KEY=c6c225cd1740456eb974abe3a5b18d016d12b2c4

# Supabase (history logging)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Authentication
AUTH_TOKEN=your_webhook_auth_token_here
ADMIN_TOKEN=your_admin_password_here

# WordPress (optional - for WordPress API access)
WP_USERNAME=your_wp_username
WP_PASSWORD=your_wp_app_password

# Google Workspace (mail-signature-designer)
# Volledige service account JSON op één regel — roteer via Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Mini-apps — AI (window.platform.ai.ask(), zie src/modules/mini-apps/lib/ai.js)
# Primaire provider is Anthropic/Claude (AI_PROVIDER in wrangler.jsonc).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Gemini blijft geregistreerd als fallback provider, key optioneel als je die niet gebruikt.
GEMINI_API_KEY=your_gemini_api_key_here

# Mini-apps — notify (optioneel, zie src/modules/mini-apps/lib/gmail-send-client.js)
# IMPERSONATE = de echte mailbox die we domain-wide impersoneren (moet bestaan).
# FROM = het adres dat de ontvanger ziet -- mag een alternatief e-mailadres/alias
# van IMPERSONATE zijn (bv. hallo-collega@mymmo.com), voeg dat eerst toe via
# Admin Console -> Directory -> Gebruikers -> alternatief e-mailadres.
# Beide default naar nico@mymmo.com als je ze weglaat.
MINI_APPS_NOTIFY_IMPERSONATE_EMAIL=nico@mymmo.com
MINI_APPS_NOTIFY_FROM_EMAIL=hallo-collega@mymmo.com

# Inloggen — versleutelt de 2FA-sleutels (src/lib/auth/crypto.js). Minstens 32 tekens.
# Zonder deze waarde kan je lokaal niet inloggen (2FA is verplicht, AUTH_MFA_MODE).
# Gebruik EXACT dezelfde waarde als de Worker-secret in Cloudflare zolang je lokaal
# tegen dezelfde Supabase draait: met een andere sleutel gaat geen enkele bestaande
# 2FA-koppeling open, en wie lokaal 2FA opnieuw instelt, overschrijft zijn koppeling
# in productie met iets wat de productie-Worker niet kan lezen.
AUTH_SECRET_KEY=your_auth_secret_key_of_minstens_32_tekens
